# ─────────────────────────────────────────────
#  MedPulse Hospital Management – .env.example
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management

# JWT – Access Token
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# JWT – Refresh Token
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────
#  File Storage
# ─────────────────────────────────────────────
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────
#  Email (SMTP) – leave USER/PASSWORD empty in
#  dev to use console-simulation fallback mode
# ─────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MedPulse Hospital <noreply@medpulse.com>"

# ─────────────────────────────────────────────
#  Payment Gateway
#  Options: mock | razorpay | stripe
# ─────────────────────────────────────────────
PAYMENT_GATEWAY_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
